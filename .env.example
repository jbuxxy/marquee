# Copy this file to .env and fill in what you have. Everything can also be
# configured later from the in-app admin settings UI at /admin — env vars
# here just take precedence and lock the corresponding field read-only there.
#
# See docs/CONFIGURATION.md for the full reference.

# ── Admin access ─────────────────────────────────────────────────────────
# Leave ADMIN_PASSWORD unset to have marquee generate one on first boot and
# print it once to the container logs (recommended for most setups).
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# ── Seerr (required — Overseerr or Jellyseerr) ──────────────────────────
SEERR_URL=
SEERR_KEY=
# SEERR_PUBLIC_URL=

# ── Media server — at least ONE of Plex or Jellyfin is required ────────
PLEX_URL=
PLEX_TOKEN=
# PLEX_PUBLIC_URL=

JELLYFIN_URL=
JELLYFIN_KEY=
# JELLYFIN_PUBLIC_URL=

# ── Optional integrations ───────────────────────────────────────────────
ABS_URL=
ABS_KEY=
# ABS_PUBLIC_URL=

# Tautulli (Plex activity stats/heatmap) and Jellystat (the same, for
# Jellyfin) are independent — set either, both, or neither. If both are set,
# whichever matches the preferred media server (admin UI only, see docs) wins.
TAUTULLI_URL=
TAUTULLI_KEY=

JELLYSTAT_URL=
JELLYSTAT_KEY=

TMDB_READ_TOKEN=

# Enriches the "Coming Soon" digital-release-dates strip, if enabled below.
TRAKT_CLIENT_ID=

# ReadMeABook — powers audiobook recommendations (with AudioBookShelf above).
RMAB_URL=
RMAB_API_TOKEN=

# ── Live map (optional, off by default) ─────────────────────────────────
# Looks up approximate viewer locations over HTTPS (ipwho.is, GeoJS fallback).
# Only the network part of each address is sent (IPv4 /24, IPv6 /48). Opt-in.
# ENABLE_GEO_MAP=true
# Home location is independently optional even with the map on — without
# it, the map just plots remote/client nodes with no home marker.
# HOME_LAT=
# HOME_LON=
# HOME_CITY=

# ── Digital release dates ("Coming Soon" strip, optional, off by default) ──
# ENABLE_DIGITAL_RELEASE_DATES=true

# ── Display & privacy toggles (optional — can also be set via the admin UI) ─
# ANONYMIZE_USERS=optional        # optional | always | never
# ENABLE_SEASONAL_EFFECTS=true
# ENABLE_EXTRA_THEMES=true

# ── Branding (optional — can also be set via the admin UI) ─────────────
SITE_NAME=
# THEME=dark

# ── Networking / security ───────────────────────────────────────────────
PORT=8080
# Set this to true only if marquee sits behind a reverse proxy (Traefik, Nginx
# Proxy Manager, Caddy, ...) that sets X-Forwarded-Proto and X-Real-IP. It makes
# cookies Secure and __Host- prefixed over HTTPS, and makes login rate limits
# use the visitor's real IP instead of the proxy's.
# TRUST_PROXY=true
# SESSION_SECRET=
# VISITOR_SESSION_SECRET=

# ── Visitor logins (Plex / Jellyfin) ────────────────────────────────────
# Optional: keep visitor sign-ins across container restarts. Point at the
# redis service in docker-compose.yml (uncomment it there).
# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=
# Plex OAuth client id; generated and saved automatically if unset.
# PLEX_CLIENT_IDENTIFIER=
